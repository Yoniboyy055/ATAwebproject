# Database
DATABASE_URL="postgresql://user:password@localhost:5432/amanuel_travel"

# NextAuth (optional - only if using OAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-use-openssl-rand-base64-32"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# WhatsApp
WHATSAPP_PHONE_NUMBER="+2917197086"

# Email (optional - for email provider)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@amanueltravel.com"
# Builder.io Configuration
# Get your API key from: https://builder.io/account/organization
NEXT_PUBLIC_BUILDER_API_KEY="your_builder_api_key_here"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sentry Error Tracking (optional - for production monitoring)
# Sign up at: https://sentry.io/
# Get DSN from: Settings → Projects → [Project] → Client Keys
NEXT_PUBLIC_SENTRY_DSN=""

# ATA WP-02 feature flags
# Safe defaults keep all WP-02 previews and deferred production features disabled.
ATA_INTEGRATION_MODE="disabled"
ATA_FLAGSHIP_PREVIEW_ENABLED="false"
ATA_TEST_REQUESTS_ENABLED="false"
ATA_CUSTOMER_ACCOUNTS_ENABLED="false"
ATA_LEGACY_ADMIN_ENABLED="false"
ATA_STAGING_ADMIN_ENABLED="false"
ATA_STAGING_PERSISTENCE_ENABLED="false"

# ---------------------------------------------------------------------------
# Proof Ledger (private-proof-ledger/) — private two-person financial record.
# Completely separate from ATA business data. Never commit real values.
# ---------------------------------------------------------------------------
# Dedicated PostgreSQL database for the ledger. Must NOT point at DATABASE_URL.
LEDGER_DATABASE_URL="postgresql://user:password@localhost:5432/proof_ledger"

# Bootstrap only. These seed the credential rows on first run and are ignored
# afterwards, so a password changed in Settings survives redeployment.
# Generate with: npm run ledger:hash-password -- "your password"
LEDGER_OWNER_PASSWORD_HASH=""
LEDGER_VIEWER_PASSWORD_HASH=""

# 32+ random characters, e.g. openssl rand -base64 48
LEDGER_SESSION_SECRET=""
# Optional. 32+ characters for signing proposal tokens. When absent, a distinct
# key is derived from LEDGER_SESSION_SECRET.
LEDGER_PROPOSAL_SECRET=""

# Server-side AI key used only for screenshot interpretation.
ANTHROPIC_API_KEY=""
# Model identifier used by the evidence interpreter. Required — no default.
LEDGER_ANTHROPIC_MODEL=""
# Optional. Overrides the Anthropic API host for a proxy or integration test.
LEDGER_ANTHROPIC_BASE_URL=""
